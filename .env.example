# Environment Variables Template
# Kopiere diese Datei zu .env und fülle deine Werte ein

# =================================
# Optional: API Keys (falls benötigt)
# =================================
# API_KEY=your_api_key_here
# OPENAI_API_KEY=sk-...

# =================================
# Optional: Custom User Agent
# =================================
# USER_AGENT=Mozilla/5.0 (Custom Agent)

# =================================
# Optional: Database (falls später benötigt)
# =================================
# DATABASE_URL=sqlite:///./data.db
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=myuser
# DB_PASSWORD=mypassword
# DB_NAME=ki_crawler

# =================================
# Optional: External Services
# =================================
# SENTRY_DSN=https://...
# LOG_LEVEL=INFO

# =================================
# Hinweise
# =================================
# Diese Datei wird NICHT in Git committed (.gitignore)
# Alle sensiblen Daten hier speichern, nicht in config.yaml
